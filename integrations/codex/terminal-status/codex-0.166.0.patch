+    anyhow::ensure!(!zombie, "process has exited");
+    let (platform, boot_id, incarnation) = match identity {
+        ProcessIdentity::Linux {
+            boot_id,
+            start_ticks,
+        } => ("linux", boot_id, start_ticks),
+        ProcessIdentity::MacOsUnique {
+            boot_id, unique_id, ..
+        } => ("macos", boot_id, unique_id),
+        ProcessIdentity::MacOs { .. } => anyhow::bail!("process identity unavailable"),
+    };
+    let boot_id = boot_id.to_ascii_lowercase();
+    anyhow::ensure!(incarnation != 0, "process incarnation is empty");
+    anyhow::ensure!(
+        boot_id.len() == 36
+            && boot_id.bytes().enumerate().all(|(index, byte)| {
+                if [8, 13, 18, 23].contains(&index) {
+                    byte == b'-'
+                } else {
+                    byte.is_ascii_hexdigit()
+                }
+            }),
+        "boot identity is invalid"
+    );
+    Ok(format!("{platform}:{boot_id}:{incarnation}"))
+}
