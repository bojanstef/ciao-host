+                    params: Some(serde_json::json!({"threadId":thread})),
+                    trace: None,
+                })
+                .await
+                .expect("transport")
+                .expect("response");
+            assert_eq!(
+                client.attached_thread_ids(),
+                std::collections::HashSet::from([thread.to_owned()])
+            );
+        }
+        assert!(
+            handle
