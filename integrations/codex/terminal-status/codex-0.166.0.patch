+            for method in ["thread/resume", "thread/read", "thread/unsubscribe"] {
+                let JSONRPCMessage::Request(request) = read_websocket_message(&mut websocket).await
+                else {
+                    panic!("request");
+                };
+                assert_eq!(request.method, method);
