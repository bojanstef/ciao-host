+//! No transcript, paths, prompts, or terminal control cross this socket.
+
+use serde::Deserialize;
+use serde::Serialize;
+use std::collections::HashSet;
+use std::sync::{Arc, Mutex};
+
+#[derive(Clone, Debug, PartialEq, Eq, Serialize)]
+pub(crate) struct ServerIdentity {
+    pub(crate) pid: u32,
+    pub(crate) identity: String,
+}
+
+#[derive(Clone, Debug, PartialEq, Eq, Serialize)]
+pub(crate) struct Connection {
+    pub(crate) kind: &'static str,
+    pub(crate) state: &'static str,
+    pub(crate) server: Option<ServerIdentity>,
+}
+
+#[derive(Clone, Debug, PartialEq, Eq, Serialize)]
+pub(crate) struct Snapshot {
+    pub(crate) v: u8,
+    pub(crate) generation: u64,
+    pub(crate) connection: Connection,
+    pub(crate) displayed_thread_id: Option<String>,
+    pub(crate) attached_thread_ids: Vec<String>,
+}
+
+#[derive(Deserialize)]
+#[serde(deny_unknown_fields)]
+struct Request {
+    v: u8,
+    r#type: String,
+}
+
+pub(crate) trait ConnectionProbe: Send + Sync {
+    fn connected(&self) -> bool;
+    fn attached_thread_ids(&self) -> HashSet<String>;
+}
+
+struct Published {
+    snapshot: Snapshot,
+    connection_generation: u64,
+    probe: Option<Arc<dyn ConnectionProbe>>,
+    previous: Option<(u64, Snapshot)>,
+    generation: u64,
+}
+
+impl Published {
+    fn current(&mut self) -> Snapshot {
+        let mut snapshot = self.snapshot.clone();
+        snapshot.generation = 0;
+        if let Some(probe) = &self.probe {
+            if !probe.connected() {
+                snapshot.connection.state = "disconnected";
+            }
+            let attached = probe.attached_thread_ids();
+            if attached.len() > 64 {
+                snapshot.attached_thread_ids = attached.into_iter().take(65).collect();
+            } else {
+                snapshot
+                    .attached_thread_ids
+                    .retain(|id| attached.contains(id));
+            }
+        }
+        if snapshot.connection.state != "connected" {
+            snapshot.connection.server = None;
+        }
+        if snapshot.connection.state != "connected" || snapshot.connection.kind == "remote" {
+            snapshot.displayed_thread_id = None;
+            snapshot.attached_thread_ids.clear();
+        }
+        snapshot.attached_thread_ids.sort();
+        if self.previous.as_ref().is_none_or(|(generation, previous)| {
+            *generation != self.connection_generation || previous != &snapshot
+        }) {
+            self.generation = self.generation.saturating_add(1);
+            self.previous = Some((self.connection_generation, snapshot.clone()));
+        }
+        snapshot.generation = self.generation;
+        snapshot
+    }
+}
+
+#[derive(Clone)]
+pub(crate) struct StatusPublisher(Arc<Mutex<Published>>);
+
+impl StatusPublisher {
+    pub(crate) fn publish(
+        &self,
+        generation: u64,
+        snapshot: Snapshot,
+        probe: Option<Arc<dyn ConnectionProbe>>,
+    ) {
+        if let Ok(mut published) = self.0.lock() {
+            published.connection_generation = generation;
+            published.snapshot = snapshot;
+            published.probe = probe;
+            let _ = published.current();
+        }
+    }
+
+    pub(crate) fn invalidate(&self) {
+        if let Ok(mut published) = self.0.lock() {
+            published.snapshot.displayed_thread_id = None;
+            published.snapshot.attached_thread_ids.clear();
+            let _ = published.current();
+        }
+    }
+}
+
+pub(crate) struct StatusService {
+    published: Arc<Mutex<Published>>,
+    #[cfg(all(test, unix))]
+    permits: Arc<tokio::sync::Semaphore>,
+    #[cfg(unix)]
+    task: tokio::task::JoinHandle<()>,
+    #[cfg(unix)]
+    _socket: SocketGuard,
+}
+
+impl StatusService {
+    pub(crate) fn start(codex_home: &std::path::Path) -> Option<Self> {
+        #[cfg(unix)]
+        match Self::bind(codex_home) {
+            Ok(service) => return Some(service),
+            Err(_) => tracing::warn!("TUI status socket unavailable"),
+        }
+        #[cfg(not(unix))]
+        let _ = codex_home;
+        None
+    }
+
+    pub(crate) fn publisher(&self) -> StatusPublisher {
+        StatusPublisher(Arc::clone(&self.published))
+    }
+
+    #[cfg(unix)]
+    fn bind(codex_home: &std::path::Path) -> std::io::Result<Self> {
+        use std::os::unix::fs::DirBuilderExt;
+        use std::os::unix::fs::MetadataExt;
+        use std::os::unix::fs::PermissionsExt;
+        let directory = codex_home.join("tui-status");
+        match std::fs::DirBuilder::new().mode(0o700).create(&directory) {
+            Ok(()) => {}
+            Err(error) if error.kind() == std::io::ErrorKind::AlreadyExists => {}
+            Err(error) => return Err(error),
+        }
+        let metadata = std::fs::symlink_metadata(&directory)?;
+        // SAFETY: geteuid has no pointer or lifetime requirements.
+        let uid = unsafe { libc::geteuid() };
+        if !metadata.is_dir() || metadata.uid() != uid || metadata.mode() & 0o777 != 0o700 {
+            return Err(std::io::Error::from(std::io::ErrorKind::PermissionDenied));
+        }
+        let path = directory.join(format!("{}.sock", std::process::id()));
+        let listener = tokio::net::UnixListener::bind(&path)?;
+        let metadata = std::fs::symlink_metadata(&path)?;
+        let socket = SocketGuard {
+            path,
+            device: metadata.dev(),
+            inode: metadata.ino(),
+        };
+        std::fs::set_permissions(&socket.path, std::fs::Permissions::from_mode(0o600))?;
+        let permits = std::sync::Arc::new(tokio::sync::Semaphore::new(4));
+        #[cfg(test)]
+        let retained_permits = Arc::clone(&permits);
+        let published = Arc::new(Mutex::new(Published {
+            snapshot: Snapshot {
+                v: 1,
+                generation: 0,
+                connection: Connection {
+                    kind: "remote",
+                    state: "disconnected",
+                    server: None,
+                },
+                displayed_thread_id: None,
+                attached_thread_ids: Vec::new(),
+            },
+            connection_generation: 0,
+            probe: None,
+            previous: None,
+            generation: 0,
+        }));
+        let status = Arc::clone(&published);
+        let task = tokio::spawn(async move {
+            let mut clients = tokio::task::JoinSet::new();
+            loop {
+                tokio::select! {
+                    result = listener.accept() => {
+                        let Ok((stream, _)) = result else { break; };
+                        let Ok(credentials) = stream.peer_cred() else { continue; };
+                        if credentials.uid() != uid { continue; }
+                        let Ok(permit) = permits.clone().try_acquire_owned() else { continue; };
+                        let status = Arc::clone(&status);
+                        clients.spawn(async move {
+                            let _permit = permit;
+                            let _ = tokio::time::timeout(
+                                std::time::Duration::from_millis(500),
+                                serve(stream, status),
+                            ).await;
+                        });
+                    }
+                    _ = clients.join_next(), if !clients.is_empty() => {}
+                }
+            }
+        });
+        Ok(Self {
+            published,
+            #[cfg(test)]
+            permits: retained_permits,
+            task,
+            _socket: socket,
+        })
+    }
+}
+
+#[cfg(unix)]
+async fn serve(
+    stream: tokio::net::UnixStream,
+    published: Arc<Mutex<Published>>,
+) -> std::io::Result<()> {
+    use tokio::io::AsyncBufReadExt;
+    use tokio::io::AsyncReadExt;
+    use tokio::io::AsyncWriteExt;
+    let (reader, mut writer) = stream.into_split();
+    let mut reader = tokio::io::BufReader::new(reader).take(257);
+    let mut line = Vec::with_capacity(64);
+    reader.read_until(b'\n', &mut line).await?;
+    if line.len() > 256 || line.last() != Some(&b'\n') {
+        return Ok(());
+    }
+    let Ok(request) = serde_json::from_slice::<Request>(&line) else {
+        return Ok(());
+    };
+    if request.v != 1 || request.r#type != "status" {
+        return Ok(());
+    }
+    let snapshot = match published.lock() {
+        Ok(mut published) => published.current(),
+        Err(_) => return Ok(()),
+    };
+    let mut response = serde_json::to_vec(&snapshot)?;
+    if response.len() >= 16384 || snapshot.attached_thread_ids.len() > 64 {
+        return Ok(());
+    }
+    response.push(b'\n');
+    writer.write_all(&response).await?;
+    writer.shutdown().await
+}
+
+#[cfg(unix)]
+struct SocketGuard {
+    path: std::path::PathBuf,
+    device: u64,
+    inode: u64,
+}
+
+#[cfg(unix)]
+impl Drop for SocketGuard {
+    fn drop(&mut self) {
+        use std::os::unix::fs::MetadataExt;
+        if let Ok(metadata) = std::fs::symlink_metadata(&self.path)
+            && metadata.dev() == self.device
+            && metadata.ino() == self.inode
+        {
+            let _ = std::fs::remove_file(&self.path);
+        }
+    }
+}
+
+impl Drop for StatusService {
+    fn drop(&mut self) {
+        #[cfg(unix)]
+        self.task.abort();
+    }
+}
