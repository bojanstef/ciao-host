+impl RemoteAppServerStatus {
+    pub fn attached_thread_ids(&self) -> HashSet<String> {
+        if !self.is_connected() {
+            return HashSet::new();
+        }
+        let threads = self
+            .attached_threads
+            .lock()
+            .map(|threads| threads.clone())
+            .unwrap_or_default();
