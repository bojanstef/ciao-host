+                    JSONRPCMessage::Error(JSONRPCError {
+                        id: request.id,
+                        error: JSONRPCErrorError {
+                            code: -32602,
+                            message: "refused".to_owned(),
+                            data: None,
+                        },
+                    })
+                } else {
+                    JSONRPCMessage::Response(JSONRPCResponse {
+                        id: request.id,
+                        result: serde_json::json!({"thread":{"id":thread}}),
+                    })
+                };
