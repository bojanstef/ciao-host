+enum PendingAttachment {
+    Existing(String),
+    New,
+}
+
+fn canonical_thread_id(thread_id: &str) -> Option<&str> {
+    (thread_id.len() == 36
+        && codex_protocol::ThreadId::from_string(thread_id)
+            .is_ok_and(|id| id.to_string() == thread_id))
+    .then_some(thread_id)
+}
+
+fn remove_attachment(
+    thread_id: &str,
+    pending: &mut HashMap<RequestId, PendingAttachment>,
+    attached: &std::sync::Mutex<RemoteAttachmentSnapshot>,
+) {
+    // A late load response must not restore a claim withdrawn by a later detach. New/forked
+    // IDs are unknown until the response, so invalidate those pending claims conservatively.
+    pending.retain(|_, request| matches!(request, PendingAttachment::Existing(expected) if expected != thread_id));
+    if let Ok(mut snapshot) = attached.lock()
+        && snapshot.thread_ids.len() < 65
+        && snapshot.thread_ids.remove(thread_id)
+    {
+        snapshot.revision = snapshot
+            .revision
+            .checked_add(1)
+            .expect("attachment revision exhausted");
+    }
+}
+
+fn acknowledge_attachment(
+    pending: PendingAttachment,
+    thread_id: &str,
+    attached: &std::sync::Mutex<RemoteAttachmentSnapshot>,
+) {
+    let Some(thread_id) = canonical_thread_id(thread_id) else {
+        return;
+    };
+    if matches!(pending, PendingAttachment::Existing(expected) if expected != thread_id) {
+        return;
+    }
+    if let Ok(mut snapshot) = attached.lock()
+        && snapshot.thread_ids.len() < 65
+        && snapshot.thread_ids.insert(thread_id.to_owned())
+    {
+        // 65 is a sticky overflow sentinel: status refuses rather than truncating ownership.
+        snapshot.revision = snapshot
+            .revision
+            .checked_add(1)
+            .expect("attachment revision exhausted");
+    }
+}
