+    #[tokio::test]
+    async fn remote_terminal_binding_tracks_acknowledged_attachment_and_refuses_stale_unsubscribe()
+    {
+        let thread = "00000000-0000-0000-0000-000000000001";
+        let url = start_test_remote_server(move |mut websocket| async move {
+            expect_remote_initialize(&mut websocket).await;
+            for method in ["thread/resume", "thread/read", "thread/unsubscribe"] {
+                let JSONRPCMessage::Request(request) = read_websocket_message(&mut websocket).await
+                else {
+                    panic!("request");
+                };
+                assert_eq!(request.method, method);
+                let message = if method == "thread/unsubscribe" {
+                    JSONRPCMessage::Error(JSONRPCError {
+                        id: request.id,
+                        error: JSONRPCErrorError {
+                            code: -32602,
+                            message: "refused".to_owned(),
+                            data: None,
+                        },
+                    })
+                } else {
+                    JSONRPCMessage::Response(JSONRPCResponse {
+                        id: request.id,
+                        result: serde_json::json!({"thread":{"id":thread}}),
+                    })
+                };
+                write_websocket_message(&mut websocket, message).await;
+            }
+            websocket.close(None).await.expect("close");
+        })
+        .await;
+        let mut client = RemoteAppServerClient::connect(test_remote_connect_args(url))
+            .await
+            .expect("connect");
+        assert!(
+            client.local_server_identity().is_none(),
+            "TCP metadata cannot authenticate a local daemon"
+        );
+        assert!(client.attached_thread_ids().is_empty());
+        let handle = client.request_handle();
+        for (id, method) in [(1, "thread/resume"), (2, "thread/read")] {
+            handle
+                .request_json_rpc(JSONRPCRequest {
+                    id: RequestId::Integer(id),
+                    method: method.to_owned(),
+                    params: Some(serde_json::json!({"threadId":thread})),
+                    trace: None,
+                })
+                .await
+                .expect("transport")
+                .expect("response");
+            assert_eq!(
+                client.attached_thread_ids(),
+                std::collections::HashSet::from([thread.to_owned()])
+            );
+        }
+        assert!(
+            handle
+                .request_json_rpc(JSONRPCRequest {
+                    id: RequestId::Integer(3),
+                    method: "thread/unsubscribe".to_owned(),
+                    params: Some(serde_json::json!({"threadId":thread})),
+                    trace: None
+                })
+                .await
+                .expect("transport")
+                .is_err()
+        );
+        assert!(
+            client.attached_thread_ids().is_empty(),
+            "even a refused unsubscribe cannot leave a stale status claim"
+        );
+        tokio::time::timeout(Duration::from_secs(2), async {
+            while client.is_connected() {
+                let _ = client.next_event().await;
+            }
+        })
+        .await
+        .expect("disconnect reaches status without UI dispatch");
+        client.shutdown().await.expect("shutdown");
+    }
