+#[cfg(any(target_os = "linux", target_os = "macos"))]
+#[tokio::test]
+async fn peer_credentials_come_from_the_connected_process() {
+    let directory = tempfile::TempDir::new().expect("socket directory");
+    let socket_path = directory.path().join("credentials.sock");
+    let mut listener = UnixListener::bind(&socket_path).await.expect("listen");
+    let mut child = std::process::Command::new(std::env::current_exe().expect("test executable"))
+        .args([
+            "--exact",
+            "lib_tests::peer_credentials_child",
+            "--nocapture",
+        ])
+        .env("CODEX_TEST_PEER_CREDENTIAL_SOCKET", &socket_path)
+        .spawn()
+        .expect("spawn connected process");
+    let mut stream = tokio::time::timeout(std::time::Duration::from_secs(5), listener.accept())
+        .await
+        .expect("connection deadline")
+        .expect("accept");
+    let credentials = stream.peer_cred().expect("kernel credentials");
+    assert_eq!(credentials.pid(), Some(child.id() as libc::pid_t));
+    // SAFETY: geteuid has no pointer or lifetime requirements.
+    assert_eq!(credentials.uid(), unsafe { libc::geteuid() });
+    assert_ne!(credentials.pid(), Some(std::process::id() as libc::pid_t));
+    stream.write_all(&[1]).await.expect("release child");
+    assert!(child.wait().expect("wait for peer").success());
+}
+
+#[cfg(any(target_os = "linux", target_os = "macos"))]
+#[test]
+fn peer_credentials_child() {
+    let Some(socket_path) = std::env::var_os("CODEX_TEST_PEER_CREDENTIAL_SOCKET") else {
+        return;
+    };
+    use std::io::Read;
+    let mut stream = std::os::unix::net::UnixStream::connect(socket_path).expect("connect");
+    stream
+        .set_read_timeout(Some(std::time::Duration::from_secs(5)))
+        .expect("read deadline");
+    let mut released = [0];
+    stream.read_exact(&mut released).expect("wait for release");
+    assert_eq!(released, [1]);
+}
